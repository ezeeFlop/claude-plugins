{
  "name": "codeur-automation-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pilotage métier de Codeur Automation pour Codex, Claude Code et Claude Desktop",
  "engines": { "node": ">=20" },
  "scripts": {
    "catalogue": "python3 scripts/export_catalogue.py",
    "catalogue:check": "python3 scripts/export_catalogue.py --check",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "node src/server.mjs",
    "package": "node scripts/build.mjs --pack"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "esbuild": "0.25.12"
  }
}
