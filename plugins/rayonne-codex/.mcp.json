{
  "mcpServers": {
    "rayonne": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "scripts/launch.py"
      ],
      "cwd": ".",
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 120,
      "env_vars": [
        "RAYONNE_API_URL",
        "RAYONNE_API_KEY",
        "RAYONNE_READ_ONLY"
      ]
    }
  }
}
