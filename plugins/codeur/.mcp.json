{
  "mcpServers": {
    "codeur-automation": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server.cjs"
      ],
      "env": {
        "CODEUR_CLIENT": "claude-code",
        "CODEUR_URL": "${user_config.url}",
        "CODEUR_API_KEY": "${user_config.api_key}"
      }
    }
  }
}
